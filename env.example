# TEP-GNSS-MGEX Environment Configuration
# Copy to .env and fill in your values (not committed to git)

# ---------------------------------------------------------------------------
# CDDIS / NASA Earthdata Credentials (REQUIRED for data download)
# ---------------------------------------------------------------------------
# Register at: https://urs.earthdata.nasa.gov/
# Then either set these env vars or add to ~/.netrc:
#   machine urs.earthdata.nasa.gov
#     login <your-username>
#     password <your-password>
CDDIS_USER=your-earthdata-username
CDDIS_PASS=your-earthdata-password

# ---------------------------------------------------------------------------
# GCP / Cloud (optional — for remote compute instances)
# ---------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_ZONE=
GCP_INSTANCE_NAME=
